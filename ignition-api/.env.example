[TEMPLATE]
# Application
NODE_ENV=development
# PORT=3001 matches the convention used by docs/development/setup-guide.md
# and avoids colliding with the Next.js frontend which defaults to port 3000.
PORT=3001
ENABLE_SWAGGER=true
# Logging: debug | info | warn | error (defaults: debug in dev, info in production)
LOG_LEVEL=debug

# Database (Prisma / PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Defaults match the lightweight docker-compose stack in /docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellaraid?schema=public"

# Database backups
# DATABASE_BACKUP_DIR stores local pg_dump files. Keep it out of git.
DATABASE_BACKUP_DIR="./backups/database"
# DATABASE_BACKUP_RETENTION_DAYS removes local backup files older than this.
DATABASE_BACKUP_RETENTION_DAYS=14
# Optional: copy every new backup into a second mounted/archive directory.
DATABASE_BACKUP_ARCHIVE_DIR=

# Redis
# Defaults match the lightweight docker-compose stack in /docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=change-me-in-production

# Admin wallet allowlist (comma-separated Stellar public keys)
# On auth, any wallet in this list will receive role=ADMIN
ADMIN_WALLETS=

# Refresh token secret (use a long random string, separate from JWT_SECRET)
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Login lockout configuration
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Session configuration
# Access token lifetime in seconds (default: 15 min)
SESSION_ACCESS_TTL_SECONDS=900
# Session / refresh token lifetime in seconds (default: 7 days)
SESSION_TTL_SECONDS=604800
# Password hashing
PASSWORD_BCRYPT_ROUNDS=12

# Sentry (crash reporting)
SENTRY_DSN=

# Stellar / SEP-10 home domain (Issue #231).
# Issued challenge format is `${STELLAR_HOME_DOMAIN}:login:<nonce>:<ts>`,
# and the verify endpoint rejects any challenge that does not begin with
# this prefix (fail-fast before the Ed25519 signature check).
#   - MUST be set (ConfigValidationService throws at boot if missing).
#   - MUST NOT contain ':' (reserved as the SEP-10 challenge delimiter).
#   - SHOULD differ between staging and prod so challenges cannot be
#     replayed across environments. DO NOT leave at the default in any
#     environment other than local dev.
#   - On rollout, any `stellaraid:`-prefixed challenges still cached in
#     Redis become invalid; they expire in ~5 min so this is a no-op for
#     end users.
STELLAR_HOME_DOMAIN=ignition-pay.local